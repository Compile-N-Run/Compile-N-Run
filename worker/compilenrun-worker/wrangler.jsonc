// Site Worker for www.compilenrun.com: Ask AI, quizzes, page feedback, learning accounts and sync. Deploy: cd worker/compilenrun-worker && npx wrangler@4 deploy
// (wrangler 3, which the repo root installs, silently drops the ratelimits bindings)
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "compilenrun-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "www.compilenrun.com/api/ask", "zone_name": "compilenrun.com" },
    { "pattern": "www.compilenrun.com/api/feedback", "zone_name": "compilenrun.com" },
    { "pattern": "www.compilenrun.com/api/quiz", "zone_name": "compilenrun.com" },
    { "pattern": "www.compilenrun.com/api/auth/*", "zone_name": "compilenrun.com" },
    { "pattern": "www.compilenrun.com/api/learning*", "zone_name": "compilenrun.com" },
    { "pattern": "www.compilenrun.com/auth/google_oauth2/callback*", "zone_name": "compilenrun.com" }
  ],
  "workers_dev": false,
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "ASK_KV", "id": "f5aeb7b0e57d46bf9e5f80d816231cb5" }],
  // Page-feedback votes (schema.sql) and learning accounts (accounts-*.sql). Was compilenrun-feedback until 2026-10-16.
  "d1_databases": [{ "binding": "DB", "database_name": "compilenrun-data", "database_id": "809f7f6c-bd2b-4fbd-8210-1170676bb6e9" }],
  // Per-IP burst limits.
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "EMAIL_PASSWORD_ENABLED": "true",
    "BREVO_SENDER_EMAIL": "no-reply@compilenrun.com",
    "BREVO_SENDER_NAME": "Compile-N-Run",
    "ACCOUNT_EMAIL_DAILY_LIMIT": "100",
    "GOOGLE_CLIENT_ID": "718000240736-hnrumls0f481uteljtu6779dpdnv9qrp.apps.googleusercontent.com",
    // Answers per day across the whole site. One answer costs ~8-10 Neurons; the free allocation is 10,000/day.
    "DAILY_LIMIT": "700",
    // Newly written quizzes per day (~50 Neurons each); cached quizzes do not count.
    "QUIZ_DAILY_LIMIT": "50"
  },
  // Mirrors the dashboard settings. Invocation logs with unredacted query strings record the OAuth callback's
  // short-lived state/code parameters; codes are single-use and exchanged immediately, but treat logs as sensitive.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issues": { "enabled": false }
  }
}
