// Site Worker for www.echo.cool (代码酷): same code as wrangler.jsonc, its own D1, KV and OAuth apps.
// Deploy: cd worker/compilenrun-worker && npx wrangler@4 deploy --config wrangler.echocool.jsonc
// (wrangler 3, which the repo root installs, silently drops the ratelimits bindings)
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "echocool-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "routes": [
    { "pattern": "www.echo.cool/api/ask", "zone_name": "echo.cool" },
    { "pattern": "www.echo.cool/api/feedback", "zone_name": "echo.cool" },
    { "pattern": "www.echo.cool/api/quiz", "zone_name": "echo.cool" },
    { "pattern": "www.echo.cool/api/auth/*", "zone_name": "echo.cool" },
    { "pattern": "www.echo.cool/api/learning*", "zone_name": "echo.cool" },
    { "pattern": "www.echo.cool/auth/google_oauth2/callback*", "zone_name": "echo.cool" },
    { "pattern": "www.echo.cool/auth/github_oauth2/callback*", "zone_name": "echo.cool" }
  ],
  "workers_dev": false,
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "ASK_KV", "id": "f7b59f222b334dd887d8427a841888f7" }],
  // Page-feedback votes (schema.sql) and learning accounts (accounts-*.sql); see README "Two deployments".
  "d1_databases": [{ "binding": "DB", "database_name": "echocool-data", "database_id": "d2c8b611-f762-4e2d-9189-b4346cbb9fb0" }],
  // Per-IP burst limits. Namespace ids are account-wide, so they must not reuse compilenrun-worker's 1001-1003.
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
    { "name": "FEEDBACK_LIMIT", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    // Which site this deployment serves (origin checks, OAuth redirect URIs, email links, Ask AI prompt).
    "SITE_ORIGIN": "https://www.echo.cool",
    "SITE_NAME": "代码酷",
    "SITE_LANG": "zh-CN",
    // Email/password accounts stay off until BREVO_API_KEY is set; then add EMAIL_PASSWORD_ENABLED "true",
    // BREVO_SENDER_EMAIL, BREVO_SENDER_NAME and ACCOUNT_EMAIL_DAILY_LIMIT as in wrangler.jsonc.
    "GOOGLE_CLIENT_ID": "1072237482521-hqchdphppq230u5agnavq59kvhjnr4iu.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Ov23lio0cF8OkEi6J4gI",
    // Answers per day across the whole site. One answer costs ~8-10 Neurons; the free allocation is 10,000/day
    // per account, shared with compilenrun-worker.
    "DAILY_LIMIT": "300",
    // Newly written quizzes per day (~50 Neurons each); cached quizzes do not count.
    "QUIZ_DAILY_LIMIT": "50"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": false,
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 0.1, "persist": true },
    "issues": { "enabled": true }
  }
}
