// Ask AI Worker for www.compilenrun.com. Deploy: cd worker/ask-ai && npx wrangler deploy
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "compilenrun-ask-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "www.compilenrun.com/api/ask", "zone_name": "compilenrun.com" }],
  "workers_dev": false,
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "ASK_KV", "id": "f5aeb7b0e57d46bf9e5f80d816231cb5" }],
  // Per-IP burst limit.
  "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    // Answers per day across the whole site. One answer costs ~50 Neurons; the free allocation is 10,000/day.
    "DAILY_LIMIT": "180"
  },
  "observability": { "enabled": true }
}
