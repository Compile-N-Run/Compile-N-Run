// Ask AI + page feedback Worker for www.compilenrun.com. Deploy: cd worker/ask-ai && npx wrangler@4 deploy
// (wrangler 3, which the repo root installs, silently drops the ratelimits bindings)
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "compilenrun-ask-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "www.compilenrun.com/api/ask", "zone_name": "compilenrun.com" },
    { "pattern": "www.compilenrun.com/api/feedback", "zone_name": "compilenrun.com" },
    { "pattern": "www.compilenrun.com/api/quiz", "zone_name": "compilenrun.com" }
  ],
  "workers_dev": false,
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "ASK_KV", "id": "f5aeb7b0e57d46bf9e5f80d816231cb5" }],
  // "Was this page helpful?" votes; table in schema.sql.
  "d1_databases": [{ "binding": "DB", "database_name": "compilenrun-feedback", "database_id": "2b024f5d-137d-4b10-8fdf-aeedd7c650af" }],
  // Per-IP burst limits.
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    // Answers per day across the whole site. One answer costs ~8-10 Neurons; the free allocation is 10,000/day.
    "DAILY_LIMIT": "700",
    // Newly written quizzes per day (~50 Neurons each); cached quizzes do not count.
    "QUIZ_DAILY_LIMIT": "50"
  },
  "observability": { "enabled": true }
}
