// Analytics dashboard: a static site on Cloudflare (Pages is now served through Workers static assets).
// Data comes from the site Worker's /api/analytics/* endpoints (worker/compilenrun-worker/src/analytics/routes.js),
// which checks a bearer token issued to site administrators (ANALYTICS_ADMINS there).
// Deploy: cd analytics-dashboard && npx wrangler@4 deploy
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cnr-analytics",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "not_found_handling": "single-page-application" },
  "workers_dev": true,
  "preview_urls": false,
  // custom_domain makes wrangler create the DNS record in the compilenrun.com zone.
  "routes": [{ "pattern": "analytics.compilenrun.com", "custom_domain": true }]
}
